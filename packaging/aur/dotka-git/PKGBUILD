# Maintainer: iYeremy

pkgname=dotka-git
_pkgname=dotka
pkgver=0.1.0
pkgrel=1
pkgdesc='A time machine for your Linux user environment: save points of your dotfiles, packages and startup programs'
arch=('x86_64' 'aarch64')
url='https://github.com/iYeremy/dotka'
license=('MIT')
depends=('glibc')
makedepends=('git' 'go')
optdepends=('pacman: show installed packages in save points (already there on Arch)')
provides=("$_pkgname")
conflicts=("$_pkgname")
source=("git+$url.git")
sha256sums=('SKIP')

pkgver() {
  cd "$_pkgname"
  # v0.1.0-3-gabc1234 -> 0.1.0.r3.gabc1234 ; no tags yet -> r42.abc1234
  if git describe --tags >/dev/null 2>&1; then
    git describe --long --tags --abbrev=7 | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
  else
    printf 'r%s.%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
  fi
}

prepare() {
  cd "$_pkgname"
  export GOPATH="$srcdir/gopath"
  # -modcacherw: keep the module cache writable so makepkg can clean it up
  export GOFLAGS='-modcacherw'
  go mod download
}

build() {
  cd "$_pkgname"
  export GOPATH="$srcdir/gopath"
  export CGO_CPPFLAGS="$CPPFLAGS"
  export CGO_CFLAGS="$CFLAGS"
  export CGO_CXXFLAGS="$CXXFLAGS"
  export CGO_LDFLAGS="$LDFLAGS"
  export GOFLAGS='-buildmode=pie -trimpath -mod=readonly -modcacherw'
  go build -ldflags "-linkmode=external -X main.version=$pkgver" -o build/dotka ./cmd/dotka
}

check() {
  cd "$_pkgname"
  export GOPATH="$srcdir/gopath"
  export GOFLAGS='-mod=readonly -modcacherw'
  go test ./...
}

package() {
  cd "$_pkgname"
  install -Dm755 build/dotka "$pkgdir/usr/bin/dotka"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 docs/*.md -t "$pkgdir/usr/share/doc/$pkgname/docs"
}
